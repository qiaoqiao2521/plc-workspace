      "inputs": {
        "Enable": "BOOL",
        "Start": "BOOL",
        "Stop": "BOOL",
        "Reset": "BOOL",
        "AtEnd": "BOOL",
        "Extended": "BOOL",
        "Retracted": "BOOL"
