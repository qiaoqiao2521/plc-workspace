      "parameters": {
        "threshold": {
          "default": 1,
          "min": 0,
          "max": 1
        }
      },
      "faults": [
        "stuck_low",
        "stuck_high"
      ]
    },
    {
      "type": "cylinder",
      "label": "双向气缸",
      "ports": {
        "inputs": {
          "extend": "BOOL",
