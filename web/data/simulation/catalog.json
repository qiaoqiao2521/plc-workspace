        "outputs": {
          "running": "BOOL"
        }
      },
      "parameters": {},
      "faults": [
        "stuck_off"
      ]
    },
    {
      "type": "conveyor",
      "label": "输送段",
      "ports": {
        "inputs": {
          "run": "BOOL"
        },
        "outputs": {
          "position": "REAL"
        }
      },
      "parameters": {
        "step": {
          "default": 0.2,
          "min": 0.01,
          "max": 1,
