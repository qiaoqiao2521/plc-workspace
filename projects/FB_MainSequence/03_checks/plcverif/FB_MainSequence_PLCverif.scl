(* Generated by validation/scripts/sync-semantics.py; edit 02_src/st. *)
FUNCTION FC_MainSequence_BusyPhase : BOOL
VAR_INPUT
    iPhase : INT := 0;
END_VAR

BEGIN
FC_MainSequence_BusyPhase := (iPhase = 1) OR (iPhase = 2) OR (iPhase = 3);

END_FUNCTION

FUNCTION FC_MainSequence_InvalidPhase : BOOL
VAR_INPUT
    iPhase : INT := 0;
END_VAR

BEGIN
FC_MainSequence_InvalidPhase := (iPhase < 0) OR ((iPhase > 3) AND (iPhase <> 900));

END_FUNCTION

FUNCTION FC_MainSequence_StepDone : BOOL
VAR_INPUT
    iPhase : INT := 0;
    xTransportDone : BOOL := FALSE;
    xFlipDone : BOOL := FALSE;
    xOutputDone : BOOL := FALSE;
END_VAR

BEGIN
CASE iPhase OF
    1:
        FC_MainSequence_StepDone := xTransportDone;
    2:
        FC_MainSequence_StepDone := xFlipDone;
    3:
        FC_MainSequence_StepDone := xOutputDone;
    ELSE
        FC_MainSequence_StepDone := FALSE;
END_CASE;

END_FUNCTION

FUNCTION FC_MainSequence_SuccessPhase : INT
VAR_INPUT
    iPhase : INT := 0;
END_VAR

BEGIN
CASE iPhase OF
    1:
        FC_MainSequence_SuccessPhase := 2;
    2:
        FC_MainSequence_SuccessPhase := 3;
    3:
        FC_MainSequence_SuccessPhase := 1;
    ELSE
        FC_MainSequence_SuccessPhase := iPhase;
END_CASE;

END_FUNCTION

FUNCTION FC_MainSequence_TimeoutReached : BOOL
VAR_INPUT
    xBusyPhase : BOOL := FALSE;
    xStepDone : BOOL := FALSE;
    uiStepTimerStat : UINT := 0;
    uiStepTimeoutScans : UINT := 0;
END_VAR

BEGIN
FC_MainSequence_TimeoutReached :=
    xBusyPhase AND
    (NOT xStepDone) AND
    (uiStepTimeoutScans > 0) AND
    ((uiStepTimerStat + 1) >= uiStepTimeoutScans);

END_FUNCTION

FUNCTION FC_MainSequence_NextPhase : INT
VAR_INPUT
    xClearReq : BOOL := FALSE;
    xAbortReq : BOOL := FALSE;
    xFaultLatched : BOOL := FALSE;
    iPhaseStat : INT := 0;
    xInvalidPhase : BOOL := FALSE;
    xStepDone : BOOL := FALSE;
    xTimeoutReached : BOOL := FALSE;
    iSuccessPhase : INT := 0;
    xStartReady : BOOL := FALSE;
END_VAR

BEGIN
IF xClearReq THEN
    FC_MainSequence_NextPhase := 0;
ELSIF xFaultLatched OR xInvalidPhase THEN
    FC_MainSequence_NextPhase := 900;
ELSIF xAbortReq THEN
    FC_MainSequence_NextPhase := 0;
ELSIF iPhaseStat = 0 THEN
    IF xStartReady THEN
        FC_MainSequence_NextPhase := 1;
    ELSE
        FC_MainSequence_NextPhase := 0;
    END_IF;
ELSIF iPhaseStat = 900 THEN
    FC_MainSequence_NextPhase := 900;
ELSIF xInvalidPhase THEN
    FC_MainSequence_NextPhase := 900;
ELSIF xStepDone THEN
    FC_MainSequence_NextPhase := iSuccessPhase;
ELSIF xTimeoutReached THEN
    FC_MainSequence_NextPhase := 900;
ELSE
    FC_MainSequence_NextPhase := iPhaseStat;
END_IF;

END_FUNCTION

FUNCTION FC_MainSequence_NextTimer : UINT
VAR_INPUT
    xResetReq : BOOL := FALSE;
    iPhaseStat : INT := 0;
    xInvalidPhase : BOOL := FALSE;
    xStepDone : BOOL := FALSE;
    xTimeoutReached : BOOL := FALSE;
    xBusyPhase : BOOL := FALSE;
    uiStepTimerStat : UINT := 0;
    uiStepTimeoutScans : UINT := 0;
END_VAR

BEGIN
IF xResetReq OR (iPhaseStat = 0) OR (iPhaseStat = 900) OR xInvalidPhase OR xStepDone OR xTimeoutReached THEN
    FC_MainSequence_NextTimer := 0;
ELSIF xBusyPhase AND (uiStepTimeoutScans > 0) THEN
    FC_MainSequence_NextTimer := uiStepTimerStat + 1;
ELSE
    FC_MainSequence_NextTimer := 0;
END_IF;

END_FUNCTION

FUNCTION FC_MainSequence_NextTimeoutFault : BOOL
VAR_INPUT
    xClearReq : BOOL := FALSE;
    xAbortReq : BOOL := FALSE;
    xTimeoutReached : BOOL := FALSE;
    xTimeoutFaultStat : BOOL := FALSE;
END_VAR

BEGIN
IF xClearReq THEN
    FC_MainSequence_NextTimeoutFault := FALSE;
ELSIF xAbortReq THEN
    FC_MainSequence_NextTimeoutFault := xTimeoutFaultStat;
ELSE
    FC_MainSequence_NextTimeoutFault := xTimeoutFaultStat OR xTimeoutReached;
END_IF;

END_FUNCTION

FUNCTION_BLOCK FB_MainSequence
VAR_INPUT
    xEnable : BOOL := FALSE;
    xEvtStart : BOOL := FALSE;
    xEStop : BOOL := FALSE;
    xStop : BOOL := FALSE;
    xReset : BOOL := FALSE;
    xInitDone : BOOL := FALSE;
    xTransportDone : BOOL := FALSE;
    xFlipDone : BOOL := FALSE;
    xOutputDone : BOOL := FALSE;
    uiStepTimeoutScans : UINT := 8;
END_VAR

VAR_OUTPUT
    iPhase : INT := 0;
    xBeltForward : BOOL := FALSE;
    xBeltReverse : BOOL := FALSE;
    xStartLamp : BOOL := FALSE;
    xResetLamp : BOOL := FALSE;
    xQ1 : BOOL := FALSE;
    xQ2 : BOOL := FALSE;
    xDone : BOOL := FALSE;
    xError : BOOL := FALSE;
    xTimeoutFault : BOOL := FALSE;
    xValid : BOOL := FALSE;
    xBusy : BOOL := FALSE;
    xCommandBusy : BOOL := FALSE;
    xCommandAborted : BOOL := FALSE;
    xTimeoutDiagnostic : BOOL := FALSE;
END_VAR

VAR
    iPhaseStat : INT := 0;
    uiStepTimerStat : UINT := 0;
    xTimeoutFaultStat : BOOL := FALSE;
    xTimeoutDiagnosticStat : BOOL := FALSE;
    xAbortedStat : BOOL := FALSE;
    xEnablePrev : BOOL := FALSE;
    xStartPrev : BOOL := FALSE;
    xResetPrev : BOOL := FALSE;
END_VAR

VAR_TEMP
    iPhasePrev : INT;
    uiStepTimerPrev : UINT;
    xTimeoutFaultPrev : BOOL;
    xDiagnosticPrev : BOOL;
    xAbortedPrev : BOOL;
    xEnableRise : BOOL;
    xStartRise : BOOL;
    xResetRise : BOOL;
    xStopReq : BOOL;
    xResetAccepted : BOOL;
    xClearReq : BOOL;
    xAbortReq : BOOL;
    xInvalidPhase : BOOL;
    xBusyPhase : BOOL;
    xFaultLatched : BOOL;
    xStepDone : BOOL;
    xTimeoutReached : BOOL;
    iPhaseNext : INT;
    uiStepTimerNext : UINT;
    xTimeoutFaultNext : BOOL;
    xDiagnosticNext : BOOL;
    xAbortedNext : BOOL;
    xStartAccepted : BOOL;
    xErrorCore : BOOL;
    xExecAllowed : BOOL;
END_VAR

BEGIN
(* Snapshot persistent internals only; outputs are never used as state. *)
iPhasePrev := iPhaseStat;
uiStepTimerPrev := uiStepTimerStat;
xTimeoutFaultPrev := xTimeoutFaultStat;
xDiagnosticPrev := xTimeoutDiagnosticStat;
xAbortedPrev := xAbortedStat;
xEnableRise := xEnable AND NOT xEnablePrev;
xStartRise := xEvtStart AND NOT xStartPrev;
xResetRise := xReset AND NOT xResetPrev;

(* xEStop is external safety-inhibit feedback, not an F safety function.
   Reset reinitializes a healthy command. Block errors need enable=FALSE. *)
xStopReq := xEStop OR xStop;
xInvalidPhase := FC_MainSequence_InvalidPhase(iPhase := iPhasePrev);
xBusyPhase := FC_MainSequence_BusyPhase(iPhase := iPhasePrev);
xFaultLatched := (iPhasePrev = 900) OR xTimeoutFaultPrev;
xResetAccepted := xEnable AND xResetRise AND NOT xStopReq AND NOT xFaultLatched AND NOT xInvalidPhase;
xClearReq := (NOT xEnable) OR xResetAccepted;
xAbortReq := xStopReq OR xReset;
xStepDone := FC_MainSequence_StepDone(
    iPhase := iPhasePrev,
    xTransportDone := xTransportDone,
    xFlipDone := xFlipDone,
    xOutputDone := xOutputDone
);
xTimeoutReached := FC_MainSequence_TimeoutReached(
    xBusyPhase := xBusyPhase,
    xStepDone := xStepDone,
    uiStepTimerStat := uiStepTimerPrev,
    uiStepTimeoutScans := uiStepTimeoutScans
);

iPhaseNext := FC_MainSequence_NextPhase(
    xClearReq := xClearReq,
    xAbortReq := xAbortReq,
    xFaultLatched := xFaultLatched,
    iPhaseStat := iPhasePrev,
    xInvalidPhase := xInvalidPhase,
    xStepDone := xStepDone,
    xTimeoutReached := xTimeoutReached,
    iSuccessPhase := FC_MainSequence_SuccessPhase(iPhase := iPhasePrev),
    xStartReady := xEnable AND xInitDone AND xStartRise
);
uiStepTimerNext := FC_MainSequence_NextTimer(
    xResetReq := xClearReq OR xAbortReq,
    iPhaseStat := iPhasePrev,
    xInvalidPhase := xInvalidPhase,
    xStepDone := xStepDone,
    xTimeoutReached := xTimeoutReached,
    xBusyPhase := xBusyPhase,
    uiStepTimerStat := uiStepTimerPrev,
    uiStepTimeoutScans := uiStepTimeoutScans
);
xTimeoutFaultNext := FC_MainSequence_NextTimeoutFault(
    xClearReq := xClearReq,
    xAbortReq := xAbortReq,
    xTimeoutReached := xTimeoutReached,
    xTimeoutFaultStat := xTimeoutFaultPrev
);
xStartAccepted := (iPhasePrev = 0) AND (iPhaseNext = 1);

(* Current errors and diagnostic history have separate lifetimes. *)
IF xEnableRise THEN
    xDiagnosticNext := xTimeoutFaultNext;
ELSE
    xDiagnosticNext := xDiagnosticPrev OR xTimeoutFaultNext;
END_IF;
IF xBusyPhase AND (xClearReq OR xAbortReq) THEN
    xAbortedNext := TRUE;
ELSIF (NOT xEnable) OR xResetAccepted OR xStartAccepted THEN
    xAbortedNext := FALSE;
ELSE
    xAbortedNext := xAbortedPrev;
END_IF;
xErrorCore := FC_MainSequence_InvalidPhase(iPhase := iPhaseNext) OR (iPhaseNext = 900);
xExecAllowed := xEnable AND NOT xAbortReq AND NOT xErrorCore;

(* Commit once. Consume input edges on every call, even while inhibited. *)
iPhaseStat := iPhaseNext;
uiStepTimerStat := uiStepTimerNext;
xTimeoutFaultStat := xTimeoutFaultNext;
xTimeoutDiagnosticStat := xDiagnosticNext;
xAbortedStat := xAbortedNext;
xEnablePrev := xEnable;
xStartPrev := xEvtStart;
xResetPrev := xReset;

(* DA008: each output is assigned once and no output is read. *)
iPhase := iPhaseNext;
xError := xErrorCore;
xTimeoutFault := xTimeoutFaultNext;
xBeltForward := xExecAllowed AND ((iPhaseNext = 1) OR (iPhaseNext = 3));
xBeltReverse := FALSE;
xStartLamp := xExecAllowed AND ((iPhaseNext = 2) OR (iPhaseNext = 3));
xResetLamp := xExecAllowed AND (iPhaseNext = 0);
xQ1 := xExecAllowed AND (iPhaseNext = 2);
xQ2 := xExecAllowed AND (iPhaseNext = 3);
xDone := xExecAllowed AND (iPhasePrev = 3) AND xOutputDone AND (iPhaseNext = 1);
xValid := xEnable AND NOT xErrorCore;
xBusy := xEnable AND NOT xErrorCore;
xCommandBusy := xExecAllowed AND FC_MainSequence_BusyPhase(iPhase := iPhaseNext);
xCommandAborted := xAbortedNext;
xTimeoutDiagnostic := xDiagnosticNext;

// End-of-invocation properties for continuous enable and explicit command policy.
//#ASSERT NOT (xBeltForward AND xBeltReverse) : P1_BeltMutualExclusion
//#ASSERT xEnable OR ((iPhase = 0) AND NOT xError AND NOT xTimeoutFault AND NOT xValid AND NOT xBusy) : P2_DisabledLifecycle
//#ASSERT NOT (((NOT xEnable) OR xAbortReq) AND (xBeltForward OR xBeltReverse OR xStartLamp OR xResetLamp OR xQ1 OR xQ2 OR xDone OR xCommandBusy)) : P3_InhibitDeenergizes
//#ASSERT NOT (xEnable AND xStopReq AND xFaultLatched AND ((iPhase <> 900) OR NOT xError)) : P4_StopPreservesFault
//#ASSERT NOT (xEnable AND xStopReq AND NOT xFaultLatched AND NOT xInvalidPhase AND (iPhase <> 0)) : P5_HealthyStopInit
//#ASSERT NOT (xResetAccepted AND ((iPhase <> 0) OR xError OR xTimeoutFault OR xDone)) : P6_AcceptedReset
//#ASSERT NOT ((NOT xClearReq) AND xFaultLatched AND ((iPhase <> 900) OR NOT xError)) : P7_FaultHolds
//#ASSERT NOT ((iPhasePrev = 0) AND (iPhase = 1) AND NOT (xEnable AND xInitDone AND xStartRise AND NOT xAbortReq)) : P8_StartRequired
//#ASSERT NOT ((NOT xClearReq) AND (NOT xAbortReq) AND NOT xFaultLatched AND (iPhasePrev = 1) AND xTransportDone AND (iPhase <> 2)) : P9_TransportCompletes
//#ASSERT NOT ((NOT xClearReq) AND (NOT xAbortReq) AND NOT xFaultLatched AND (iPhasePrev = 2) AND xFlipDone AND (iPhase <> 3)) : P10_FlipCompletes
//#ASSERT NOT ((NOT xClearReq) AND (NOT xAbortReq) AND NOT xFaultLatched AND (iPhasePrev = 3) AND xOutputDone AND ((iPhase <> 1) OR NOT xDone)) : P11_OutputCompletes
//#ASSERT NOT ((NOT xClearReq) AND (NOT xAbortReq) AND NOT xFaultLatched AND xBusyPhase AND NOT xStepDone AND NOT xTimeoutReached AND (iPhase <> iPhasePrev)) : P12_BusyHolds
//#ASSERT NOT ((NOT xClearReq) AND (NOT xAbortReq) AND xBusyPhase AND xTimeoutReached AND ((iPhase <> 900) OR NOT xError OR NOT xTimeoutFault)) : P13_TimeoutCommitsTogether
//#ASSERT NOT (xTimeoutFault AND ((iPhase <> 900) OR NOT xError)) : P14_FaultPhaseConsistent
//#ASSERT NOT (xError AND (xBeltForward OR xBeltReverse OR xStartLamp OR xQ1 OR xQ2 OR xDone OR xCommandBusy OR xValid OR xBusy)) : P15_ErrorDeenergizes
//#ASSERT NOT ((NOT xClearReq) AND xInvalidPhase AND ((iPhase <> 900) OR NOT xError)) : P16_InvalidPhase
//#ASSERT NOT ((xClearReq OR xAbortReq OR NOT xBusyPhase OR xStepDone OR xTimeoutReached) AND (uiStepTimerStat <> 0)) : P17_TimerReset
//#ASSERT NOT (xDone AND ((iPhasePrev <> 3) OR (iPhase <> 1) OR NOT xOutputDone)) : P18_DoneTransition
//#ASSERT NOT (xEnableRise AND (xTimeoutDiagnostic <> xTimeoutFault)) : P19_DiagnosticNewSession
//#ASSERT NOT ((NOT xEnableRise) AND xDiagnosticPrev AND NOT xTimeoutDiagnostic) : P20_DiagnosticRetained
//#ASSERT (xValid = (xEnable AND NOT xError)) AND (xBusy = xValid) : P21_ValidBusy
//#ASSERT xCommandBusy = (xEnable AND NOT xAbortReq AND NOT xError AND ((iPhase = 1) OR (iPhase = 2) OR (iPhase = 3))) : P22_CommandBusy
//#ASSERT NOT (xBusyPhase AND (xClearReq OR xAbortReq) AND NOT xCommandAborted) : P23_CommandAbort
//#ASSERT NOT ((NOT xClearReq) AND (NOT xAbortReq) AND NOT xFaultLatched AND xBusyPhase AND NOT xStepDone AND NOT xTimeoutReached AND xError) : P24_NoEarlyFault
//#ASSERT NOT ((NOT xClearReq) AND xTimeoutFaultPrev AND NOT xTimeoutFault) : P25_TimeoutReasonHeld
//#ASSERT NOT (xTimeoutFault AND NOT xTimeoutDiagnostic) : P26_DiagnosticRecordsFault
// Added after the 2026-09-22 adversarial variant pass; see docs/DECISIONS.md.
//#ASSERT (xStartPrev = xEvtStart) AND (xResetPrev = xReset) AND (xEnablePrev = xEnable) : P27_EdgeMemoriesTrackInputs
//#ASSERT NOT ((iPhasePrev = 0) AND (iPhase = 1) AND xCommandAborted) : P28_AbortClearedOnAcceptedStart
// P29-P31 derive the deadline from the threshold input, the prior timer and the
// completion levels only; xTimeoutReached never gates a check. The deadline
// "prevTimer+1 >= N" is written overflow-free as "prev < 65535 AND prev >= N-1";
// From initialization, prev never exceeds 65534: N=0 clears the timer,
// and any positive UINT threshold expires before another increment can reach 65535.
// The prev=65535 branches are outside this reachable-state proof; they do not
// establish behavior for injected state or cross-tool overflow equivalence.
//#ASSERT NOT ((NOT xClearReq) AND (NOT xAbortReq) AND xBusyPhase AND (NOT xStepDone) AND (NOT xTimeoutFaultPrev) AND (uiStepTimeoutScans > 0) AND ((uiStepTimerPrev = 65535) OR (uiStepTimerPrev < (uiStepTimeoutScans - 1))) AND xError) : P29_NoEarlyExpiration
//#ASSERT NOT ((NOT xClearReq) AND (NOT xAbortReq) AND xBusyPhase AND (NOT xStepDone) AND (uiStepTimeoutScans > 0) AND (uiStepTimerPrev < 65535) AND (uiStepTimerPrev >= (uiStepTimeoutScans - 1)) AND ((iPhase <> 900) OR (NOT xError) OR (NOT xTimeoutFault))) : P30_DeadlineObligation
